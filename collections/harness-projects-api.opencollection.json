{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harness Platform Organizations Projects API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Harness List Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.harness.io/gateway/ng/api/projects",
            "params": [
              {
                "name": "accountIdentifier",
                "value": "",
                "type": "query",
                "description": "Account identifier."
              },
              {
                "name": "orgIdentifier",
                "value": "",
                "type": "query",
                "description": "Organization identifier."
              }
            ]
          },
          "docs": "List projects in the account."
        }
      ]
    }
  ],
  "bundled": true
}