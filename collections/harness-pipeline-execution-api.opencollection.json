{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harness Platform Organizations Pipeline Execution API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pipeline Execution",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Harness Execute Pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.harness.io/gateway/pipeline/api/pipelines/execute/:pipelineIdentifier",
            "params": [
              {
                "name": "pipelineIdentifier",
                "value": "",
                "type": "path",
                "description": "Pipeline identifier."
              },
              {
                "name": "accountIdentifier",
                "value": "",
                "type": "query"
              },
              {
                "name": "orgIdentifier",
                "value": "",
                "type": "query"
              },
              {
                "name": "projectIdentifier",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a pipeline by its identifier."
        }
      ]
    }
  ],
  "bundled": true
}