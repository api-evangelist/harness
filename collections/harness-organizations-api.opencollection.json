{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harness Platform Organizations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Harness List Organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.harness.io/gateway/ng/api/organizations",
            "params": [
              {
                "name": "accountIdentifier",
                "value": "abc123",
                "type": "query",
                "description": "Account identifier."
              },
              {
                "name": "pageIndex",
                "value": "",
                "type": "query",
                "description": "Page number (0-based)."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              }
            ]
          },
          "docs": "List organizations in the account."
        }
      ]
    }
  ],
  "bundled": true
}